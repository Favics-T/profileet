// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DesignerProfile {
  id                Int      @id
  designerId        String   @unique
  designer          User     @relation(fields: [designerId], references: [id], onDelete: Cascade)
  fullName          String   @default("")
  specialty         String   @default("")
  location          String   @default("")
  bio               String   @default("")
  phone             String   @default("")
  yearsOfExperience Int      @default(0)
  avatar            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Booking {
  id             String   @id @default(cuid())
  designerId     String
  designer       User     @relation("BookingDesigner", fields: [designerId], references: [id], onDelete: Cascade)
  clientId       String?
  clientUser     User?    @relation("BookingClient", fields: [clientId], references: [id], onDelete: SetNull)
  client         String
  initials       String
  clientColor    String
  clientPhone    String   @default("")
  service        String
  occasion       String
  deliveryDate   String
  quantity       Int      @default(1)
  urgent         Boolean  @default(false)
  status         String   @default("pending")
  receivedAt     String
  price          Int
  depositPaid    Boolean  @default(false)
  depositAmount  Int
  designNotes    String   @default("")
  fabrics        String[] @default([])
  colors         String[] @default([])
  inspirationRef String   @default("")
  measurements   Json?
  consultation   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

 
model Inquiry {
  id        String   @id @default(cuid())
  designerId String
  designer  User     @relation("InquiryDesigner", fields: [designerId], references: [id], onDelete: Cascade)
  clientId  String?
  clientUser User?    @relation("InquiryClient", fields: [clientId], references: [id], onDelete: SetNull)
  client    String
  service   String
  date      String
  status    String   @default("New")
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Availability {
  id          String   @id @default(cuid())
  date        String
  designerId  String
  designer    User     @relation(fields: [designerId], references: [id], onDelete: Cascade)
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([designerId, date])
}


model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  role               String   @default("designer")
  designerProfile    DesignerProfile?
  bookingOwnerships  Booking[]         @relation("BookingDesigner")
  bookingClients     Booking[]         @relation("BookingClient")
  inquiryOwnerships  Inquiry[]         @relation("InquiryDesigner")
  inquiryClients     Inquiry[]         @relation("InquiryClient")
  availability       Availability[]
  reviews            Review[]
  portfolioItems     PortfolioItem[]
  messageOwnerships  MessageConversation[]
  clientProfile      ClientProfile?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}


model Review {
  id         String   @id @default(cuid())
  designerId String
  designer   User     @relation(fields: [designerId], references: [id], onDelete: Cascade)
  client     String
  initials   String
  color      String
  service    String
  rating     Int
  date       String
  text       String
  helpful    Int      @default(0)
  replied    Boolean  @default(false)
  reply      String?
  bookingId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model PortfolioItem {
  id          String   @id @default(cuid())
  designerId  String
  designer    User     @relation(fields: [designerId], references: [id], onDelete: Cascade)
  title       String
  tag         String
  description String   @default("")
  imageUrl    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Designer {
  id              String   @id
  name            String
  email           String   @unique
  specialty       String
  location        String
  rating          Float    @default(0)
  reviews         Int      @default(0)
  startingPrice   Int      @default(0)
  available       Boolean  @default(true)
  status          String   @default("Pending")
  joined          String
  bio             String   @default("")
  phone           String   @default("")
  yearsOfExperience Int    @default(0)
  inquiries       Int      @default(0)
  bookings        Int      @default(0)
  initials        String
  color           String
  styles          String[] @default([])
  notes           DesignerNote[]
  messages        MessageConversation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DesignerNote {
  id         String   @id
  designerId String
  designer   Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)
  author     String
  role       String
  content    String
  createdAt  String
}

model MessageConversation {
  id                  Int      @id
  directoryDesignerId String
  directoryDesigner   Designer @relation(fields: [directoryDesignerId], references: [id], onDelete: Cascade)
  designerId          String
  designer            User     @relation(fields: [designerId], references: [id], onDelete: Cascade)
  designerName        String
  initials            String
  color               String
  lastMessage         String
  time                String
  unread              Int      @default(0)
  messages            Message[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Message {
  id              Int      @id
  conversationId  Int
  conversation    MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from            String
  text            String
  time            String
  createdAt       DateTime @default(now())
}

model ClientProfile {
  id             Int      @id
  clientId       String   @unique
  clientUser     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName      String   @default("")
  lastName       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  location       String   @default("")
  bio            String   @default("")
  bookingUpdates Boolean  @default(true)
  newMessages    Boolean  @default(true)
  promotions     Boolean  @default(false)
  reminders      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProfileView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
