// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DesignerProfile {
  id                Int @id
  fullName          String   @default("")
  specialty         String   @default("")
  location          String   @default("")
  bio               String   @default("")
  phone             String   @default("")
  yearsOfExperience Int      @default(0)
  avatar            String?  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Booking {
  id             String   @id @default(cuid())
  client         String
  initials       String
  clientColor    String
  clientPhone    String   @default("")
  service        String
  occasion       String
  deliveryDate   String
  quantity       Int      @default(1)
  urgent         Boolean  @default(false)
  status         String   @default("pending")
  receivedAt     String
  price          Int
  depositPaid    Boolean  @default(false)
  depositAmount  Int
  designNotes    String   @default("")
  fabrics        String[] @default([])
  colors         String[] @default([])
  inspirationRef String   @default("")
  measurements   Json?
  consultation   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

 
model Inquiry {
  id        String   @id @default(cuid())
  client    String
  service   String
  date      String                          
  status    String   @default("New")       
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Availability {
  date   String @id                         
  status String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt                          
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("designer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Review {
  id        String   @id @default(cuid())
  client    String
  initials  String
  color     String
  service   String
  rating    Int
  date      String
  text      String
  helpful   Int      @default(0)
  replied   Boolean  @default(false)
  reply     String?
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  tag         String
  description String   @default("")
  imageUrl    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
