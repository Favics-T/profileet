// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model ArtisanProfile {
  id                String        @id @default(cuid())
  artisanId         String        @unique
  artisan           User          @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  
  fullName          String        @default("")
  initials          String        @default("")
  color             String        @default("#422a15")
  avatar            String?

  
  specialty         String        @default("")
  location          String        @default("")
  bio               String        @default("")
  phone             String        @default("")
  yearsOfExperience Int           @default(0)
  styles            String[]      @default([])

    available         Boolean       @default(true)
  status            ArtisanStatus @default(Pending)
  joined            String        @default("")

  // Relation
  notes             ArtisanNote[]
  messages          MessageConversation[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Booking {
  id             String   @id @default(cuid())
  artisanId      String   @map("designerId") 
  artisan        User     @relation("BookingArtisan", fields: [artisanId], references: [id], onDelete: Cascade)
  clientId       String?
  clientUser     User?    @relation("BookingClient", fields: [clientId], references: [id], onDelete: SetNull)
  client         String
  initials       String
  clientColor    String
  clientPhone    String   @default("")
  service        String
  occasion       String
  deliveryDate   String
  quantity       Int      @default(1)
  urgent         Boolean  @default(false)
  status         String   @default("pending")
  receivedAt     DateTime @default(now())
  price          Int
  depositPaid    Boolean  @default(false)
  depositAmount  Int
  designNotes    String   @default("")
  fabrics        String[] @default([])
  colors         String[] @default([])
  inspirationRef String   @default("")
  measurements   Json?
  consultation   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model Inquiry {
  id         String  @id @default(cuid())
  artisanId  String  @map("designerId")
  artisan    User    @relation("InquiryArtisan", fields: [artisanId], references: [id], onDelete: Cascade)
  clientId   String?
  clientUser User?   @relation("InquiryClient", fields: [clientId], references: [id], onDelete: SetNull)
  client     String
  service    String
  date       String
  status     String  @default("New")
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model Availability {
  id         String   @id @default(cuid())
  date       String
  artisanId  String   @map("designerId")
  artisan    User     @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([artisanId, date])
}


model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  password          String
  role              Role            @default(artisan)
  artisanProfile    ArtisanProfile?
  bookingOwnerships Booking[]       @relation("BookingArtisan")
  bookingClients    Booking[]       @relation("BookingClient")
  inquiryOwnerships Inquiry[]       @relation("InquiryArtisan")
  inquiryClients    Inquiry[]       @relation("InquiryClient")
  availability      Availability[]
  reviews           Review[]
  portfolioItems    PortfolioItem[]
  messageOwnerships MessageConversation[]
  clientProfile     ClientProfile?
  profileViews      ProfileView[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}


model Review {
  id         String   @id @default(cuid())
  artisanId  String   @map("designerId")
  artisan    User     @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  client     String
  initials   String
  color      String
  service    String
  rating     Int
  date       String
  text       String
  helpful    Int      @default(0)
  replied    Boolean  @default(false)
  reply      String?
  bookingId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model PortfolioItem {
  id          String   @id @default(cuid())
  artisanId   String   @map("designerId")
  artisan     User     @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  title       String
  tag         String
  description String   @default("")
  imageUrl    String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model ArtisanNote {
  id               String         @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)
  author           String
  role             String
  content          String
  createdAt        String
}


model MessageConversation {
  id               Int            @id @default(autoincrement())
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)
  artisanId        String         @map("designerId")
  artisan          User           @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  artisanName      String
  initials         String
  color            String
  lastMessage      String
  time             String
  unread           Int            @default(0)
  messages         Message[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}


model Message {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  conversation   MessageConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from           String
  text           String
  time           String
  createdAt      DateTime @default(now())
}


model ClientProfile {
  id             Int      @id @default(autoincrement())
  clientId       String   @unique
  clientUser     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName      String   @default("")
  lastName       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  location       String   @default("")
  bio            String   @default("")
  bookingUpdates Boolean  @default(true)
  newMessages    Boolean  @default(true)
  promotions     Boolean  @default(false)
  reminders      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model ProfileView {
  id         String   @id @default(cuid())
  artisanId  String   @map("designerId")
  artisan    User     @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}


enum Role {
  client
  artisan
  admin
}

enum ArtisanStatus {
  Pending
  Approved
  Rejected
  Verified
  Active
}
